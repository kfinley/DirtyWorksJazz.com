{
  "compilerOptions": {
    "strict": true,
    "jsx": "preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true
  },
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/src/**/*.ts", 
    "packages/**/src/**/*.tsx", 
    "packages/**/src/**/*.vue"
    ]
}
